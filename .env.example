# Copy this to .env and fill in your values
# Never commit .env to git

# Llama / Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Personal OS
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
JSEARCH_API_KEY=

# App
APP_SECRET_KEY=change-this-to-a-random-secret
APP_DEBUG=true
PERSONAL_OS_API_KEY=
PERSONAL_OS_API_KEYS=
PERSONAL_OS_RETENTION_DAYS=90
PERSONAL_OS_RETENTION_ON_STARTUP=true
PERSONAL_OS_MAX_PROMPT_CHARS=20000
PERSONAL_OS_MAX_MEMORY_CONTEXT_CHARS=6000
PERSONAL_OS_MAX_OUTPUT_CHARS=12000
PERSONAL_OS_MODEL_RETRIES=2
PERSONAL_OS_TOOL_RETRIES=2
PERSONAL_OS_ACTION_TIMEOUT_SECONDS=30
PERSONAL_OS_GROQ_TIMEOUT_SECONDS=30
PERSONAL_OS_OLLAMA_TIMEOUT_SECONDS=120
PERSONAL_OS_TOOL_TIMEOUT_SECONDS=15
PERSONAL_OS_MODEL_BACKEND=auto
PERSONAL_OS_MODEL_ORDER=groq,ollama,openrouter,gemini
PERSONAL_OS_EMBEDDING_PROVIDER=local
OLLAMA_EMBEDDING_MODEL=llama3.2
PERSONAL_OS_SENTENCE_TRANSFORMERS_MODEL=BAAI/bge-small-en-v1.5
PERSONAL_OS_EMBEDDING_TIMEOUT_SECONDS=15
PERSONAL_OS_BLOCK_HIGH_RISK_PROMPTS=false
PERSONAL_OS_VECTOR_BACKEND=sqlite
PERSONAL_OS_VECTOR_REQUIRED=false
PERSONAL_OS_CHROMA_DIR=./data/chroma
PERSONAL_OS_CHROMA_COLLECTION=personal_os_rag
PERSONAL_OS_RERANKER=lexical
PERSONAL_OS_PLAYWRIGHT_SCRAPE=false

# Gmail (optional - for email agent)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Paths
DATA_DIR=./data
EXCEL_DIR=./data/excel
